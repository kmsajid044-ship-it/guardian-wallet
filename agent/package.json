{
  "name": "agent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check:chain": "tsx src/chain/checkLocalConfig.ts",
    "prebuild": "pnpm check:chain",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:parity:evm-local": "PARITY_BACKEND=evm-local vitest run src/policy/backendParity.test.ts",
    "test:parity:fisco": "PARITY_BACKEND=fisco vitest run src/policy/backendParity.test.ts",
    "test:parity": "pnpm test:parity:evm-local && pnpm test:parity:fisco"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "node-cron": "^4.6.0",
    "viem": "^2.57.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
