# Guardian Wallet research prototype. Local simulated ledger only; no real money.
CHAIN_BACKEND=fisco
RPC_URL=http://127.0.0.1:8545
FISCO_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
DEPLOYMENTS_FILE=./deployments/fisco.json
VITE_NETWORK=local-fisco

# Placeholders only. Keep actual signing values in the ignored .env file.
AGENT_PRIVATE_KEY=0xYOUR_LOCAL_AGENT_KEY
AGENT_ADDRESS=0xYOUR_LOCAL_AGENT_ADDRESS
OWNER_PRIVATE_KEY=0xYOUR_LOCAL_OWNER_KEY
GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000
FEE_ACCOUNT_ADDRESS=0xSYNTHETIC_FEE_ACCOUNT_ADDRESS
DEMO_CONTACT_1_ADDRESS=0xSYNTHETIC_CONTACT_1_ADDRESS
DEMO_CONTACT_2_ADDRESS=0xSYNTHETIC_CONTACT_2_ADDRESS
DEMO_CONTACT_3_ADDRESS=0xSYNTHETIC_CONTACT_3_ADDRESS

AGENT_PORT=8787
AUDIT_DB_PATH=./agent/data/audit.sqlite
OWNER_TIMEZONE=Asia/Shanghai
OWNER_ACTIVE_HOURS=08-22
# mock = offline rules (no key needed). groq = free Groq API; gemini = Gemini API; mistral = Mistral API.
LLM_PROVIDER=mock
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=ministral-8b-2512
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_COMPAT_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_COMPAT_API_KEY=your-openai-compat-api-key
OPENAI_COMPAT_MODEL=your-model-name

RISK_INTEL_PORT=8788
RISK_INTEL_URL=http://127.0.0.1:8788
VITE_AGENT_API_URL=http://127.0.0.1:8787
VITE_CHAIN_ID=1337
VITE_DEMO_OWNER_KEY=
